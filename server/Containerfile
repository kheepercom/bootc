FROM quay.io/fedora/fedora-bootc:45 AS builder
COPY server.yaml /usr/share/doc/bootc-base-imagectl/manifests/
RUN /usr/libexec/bootc-base-imagectl build-rootfs --manifest=server /target-rootfs

FROM scratch
COPY --from=builder /target-rootfs/ /
LABEL containers.bootc=1 ostree.bootable=1
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

COPY server.nft /usr/lib/nftables/server.nft
COPY nftables.conf /usr/lib/systemd/system/nftables.service.d/server.conf
COPY sshd.conf /etc/ssh/sshd_config.d/10-server.conf
COPY journald.conf /usr/lib/systemd/journald.conf.d/10-server.conf
COPY nm-wait-online.conf /usr/lib/systemd/system/NetworkManager-wait-online.service.d/10-server.conf
RUN mkdir /usr/lib/nftables/server.d \
	&& systemctl enable nftables bootc-fetch-apply-updates.timer

RUN bootc container lint
