#!/bin/bash
# Writes a config serving headscale at https://<public IP> with a Let's Encrypt
# IP certificate and the embedded DERP as the only relay, then starts it.
set -euo pipefail

ip=$(curl -fsS -4 --retry 5 --retry-connrefused https://ifconfig.co)
config=/etc/headscale/config.yaml

mkdir -p /var/lib/lego
echo "$ip" >/var/lib/lego/ip
/usr/libexec/headscale-easy-cert

cat >"$config.tmp" <<YAML
server_url: https://${ip}
listen_addr: 0.0.0.0:443
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
tls_cert_path: /run/credentials/headscale.service/tls.crt
tls_key_path: /run/credentials/headscale.service/tls.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
derp:
  server:
    enabled: true
    region_id: 999
    region_code: headscale
    region_name: Headscale Embedded DERP
    stun_listen_addr: 0.0.0.0:3478
    private_key_path: /var/lib/headscale/derp_server_private.key
    ipv4: ${ip}
  urls: []
dns:
  magic_dns: false
  override_local_dns: false
YAML
mv "$config.tmp" "$config"
systemctl start --no-block headscale
