#!/bin/bash
set -euo pipefail

install -D -m 0640 -g keycloak "$LEGO_HOOK_CERT_PATH" /etc/keycloak/tls/cert.pem
install -m 0640 -g keycloak "$LEGO_HOOK_CERT_KEY_PATH" /etc/keycloak/tls/key.pem
# Keycloak rereads its certificate hourly, so it only needs starting the first time.
systemctl start --no-block keycloak
