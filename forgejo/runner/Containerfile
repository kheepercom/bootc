FROM us.kheeper.com/bootc/server:45

ARG VERSION=13.2.2
ARG SHA256=6b077ccadc22036ba049cea39b09cfbdc5e5ad6000a38f90c83a19e4fb815543
RUN curl -fsSLo /usr/bin/forgejo-runner https://code.forgejo.org/forgejo/runner/releases/download/v${VERSION}/forgejo-runner-${VERSION}-linux-amd64 \
	&& echo "${SHA256}  /usr/bin/forgejo-runner" | sha256sum -c \
	&& chmod 0755 /usr/bin/forgejo-runner

# The runner and its podman socket run in the runner user's own systemd
# session, which lingers so it starts at boot.
COPY forgejo-runner.sysusers /usr/lib/sysusers.d/forgejo-runner.conf
COPY forgejo-runner.tmpfiles /usr/lib/tmpfiles.d/forgejo-runner.conf
COPY forgejo-runner-subid.service /usr/lib/systemd/system/
COPY forgejo-runner.service /usr/lib/systemd/user/
RUN systemctl enable forgejo-runner-subid \
	&& mkdir -p /usr/lib/systemd/user/default.target.wants \
	&& ln -s ../forgejo-runner.service /usr/lib/systemd/user/default.target.wants/forgejo-runner.service

RUN bootc container lint
